msgstr "Laden Sie alle Dateien aus dem Cursor-Terminal hoch (``boot.py`` zuletzt):"

#: ../../../Users/csillag/Projects/goesflarewatch/docs/mp_install_esp32.rst:60
msgid "Or as a single command:"
msgstr "Oder als ein einziger Befehl:"

#: ../../../Users/csillag/Projects/goesflarewatch/docs/mp_install_esp32.rst:67
msgid "If the board is running the old program"
msgstr "Wenn auf dem Board noch das alte Programm läuft"

#: ../../../Users/csillag/Projects/goesflarewatch/docs/mp_install_esp32.rst:69
